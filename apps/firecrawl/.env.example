# Copy to .env on the Docker host. Do not commit the resulting .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
# Keep this as postgres for Firecrawl's bundled pg_cron configuration.
POSTGRES_DB=postgres
# This deployment is exposed only through the tailnet-protected Traefik route.
USE_DB_AUTHENTICATION=false
