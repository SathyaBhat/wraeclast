# Copy to .env in the Dokploy emini-poster app (or define these values in its UI).
# Dokploy writes UI variables to .env; docker-compose.yml injects them with env_file.
# Home Assistant: Profile -> Security -> Long-lived access tokens. Do not commit it.
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token
# The battery charge sensor to graph; list candidates with:
#   docker exec emini-poster python /app/ha_poster.py --list
BATTERY_ENTITY=sensor.replace-with-battery-state-of-charge
# Optional, shown with their defaults.
HA_URL=http://homeassistant.bishop-bass.ts.net
WEATHER_ENTITY=weather.forecast_home
# The NOTE4C by IP (DHCP-reserved); its home-ff2e.local name does not resolve in containers.
EMINI_HOST=192.168.0.49
HOURS=24
# 1 switches the NOTE4C to Picture every hour; 0 only updates the picture.
SHOW=1
