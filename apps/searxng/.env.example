# Copy to .env in the Dokploy SearXNG app (or define these values in its UI).
# Dokploy writes UI variables to .env; docker-compose.yml injects them with env_file.
SEARXNG_BASE_URL=https://wraeclast.bishop-bass.ts.net/searxng/
SEARXNG_INSTANCE_NAME=Wraeclast Search
# Generate once with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-64-character-random-hex-secret
SEARXNG_PORT=8080
SEARXNG_BIND_ADDRESS=0.0.0.0
# Valkey is wired now so rate limiting can be enabled later without changing topology.
SEARXNG_VALKEY_URL=valkey://valkey:6379/0
